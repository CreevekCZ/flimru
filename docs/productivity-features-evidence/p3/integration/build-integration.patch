+fn live(log: &Path, script: &str) -> runs::Run {
+    let session = Session::start(
+        &flimru::tool::RunCommand {
+            capture_vm_service: false,
+            executable: "/bin/bash".into(),
+            args: vec!["-c".into(), script.into()],
