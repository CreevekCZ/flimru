+            env: std::collections::BTreeMap::from([(
+                "INPUT_LOG".into(),
+                log.to_string_lossy().into_owned(),
+            )]),
+        },
+        15,
+        120,
+    )
+    .unwrap();
+    runs::Run::running(
+        Device {
+            id: log.to_string_lossy().into_owned(),
+            name: "Live pixel".into(),
+            platform: "android".into(),
+            available: true,
+            favorite: false,
+        },
+        "Frozen launch-time config".into(),
+        session,
+    )
