+        app.review.as_ref().unwrap().source().unwrap().captured_at,
+        captured_at
+    );
+    app.close_review();
+    app.runs[0].history_capacity = Session::SCROLLBACK_CAPACITY;
+    app.runs[0].max_columns = 500;
+    app.runs[0]
+        .console
+        .as_mut()
