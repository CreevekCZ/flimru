+    app.open_export();
+    assert!(app.pending_export.is_none());
+    assert!(
+        app.status
+            .contains("Start a new session in a narrower terminal")
+    );
+    assert!(!app.status.contains("Wait for capture"));
+    app.close_review();
+    app.open_export();
+    assert!(app.pending_export.as_ref().unwrap().capture.is_none());
+    assert!(
+        app.last_operation
+            .as_ref()
+            .unwrap()
+            .contains("Start a new session in a narrower terminal")
+    );
+}
